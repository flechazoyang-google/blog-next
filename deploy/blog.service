[Unit]
Description=flechazo blog (Next.js)
Documentation=https://blog.yghsite.cn
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=blog
Group=blog
WorkingDirectory=/opt/blog
Environment=NODE_ENV=production
Environment=PORT=8090
Environment=HOSTNAME=127.0.0.1
Environment=DATA_DIR=/var/lib/blog
Environment=UPLOAD_DIR=/var/lib/blog/images
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5

# 内存硬上限（依据：Next.js SSR 实测 180~250MB）
MemoryHigh=280M
MemoryMax=350M

# 基础加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/blog
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
